{
  "openapi": "3.1.0",
  "info": {"title":"Quarks Click API","version":"2.1.0","description":"Short URL CRUD and visit analytics use X-Shlink-Api-Key only. API key administration uses HTTP Basic Auth."},
  "servers": [{"url":"https://admin.quarks.click/admin-api"}],
  "paths": {
    "/short-urls": {
      "get": {"summary":"List short URLs","security":[{"shlinkApiKey":[]}],"parameters":[{"$ref":"#/components/parameters/Page"},{"$ref":"#/components/parameters/ItemsPerPage"},{"$ref":"#/components/parameters/SearchTerm"},{"$ref":"#/components/parameters/TagsQuery"}],"responses":{"200":{"description":"Paginated short URLs","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedShortUrls"}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}},
      "post": {"summary":"Create a short URL","security":[{"shlinkApiKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateShortUrl"},"example":{"longUrl":"https://example.com/docs","customSlug":"docs","tags":["public"]}}}},"responses":{"200":{"description":"Created short URL","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShortUrl"}}}},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"}}}
    },
    "/short-urls/{shortCode}": {
      "parameters":[{"$ref":"#/components/parameters/ShortCode"}],
      "get":{"summary":"Get a short URL","security":[{"shlinkApiKey":[]}],"responses":{"200":{"description":"Short URL details","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ShortUrl"}}}},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"}}},
      "patch":{"summary":"Update a short URL","security":[{"shlinkApiKey":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateShortUrl"}}}},"responses":{"200":{"description":"Updated short URL"},"400":{"$ref":"#/components/responses/BadRequest"},"401":{"$ref":"#/components/responses/Unauthorized"}}},
      "delete":{"summary":"Delete a short URL","security":[{"shlinkApiKey":[]}],"responses":{"204":{"description":"Deleted"},"401":{"$ref":"#/components/responses/Unauthorized"},"404":{"$ref":"#/components/responses/NotFound"}}}
    },
    "/short-urls/{shortCode}/visits": {"parameters":[{"$ref":"#/components/parameters/ShortCode"},{"$ref":"#/components/parameters/StartDate"},{"$ref":"#/components/parameters/EndDate"},{"$ref":"#/components/parameters/Page"},{"$ref":"#/components/parameters/ItemsPerPage"}],"get":{"summary":"Get visits for one short URL","security":[{"shlinkApiKey":[]}],"responses":{"200":{"$ref":"#/components/responses/Visits"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/visits": {"get":{"summary":"Get global visit analytics","security":[{"shlinkApiKey":[]}],"parameters":[{"$ref":"#/components/parameters/StartDate"},{"$ref":"#/components/parameters/EndDate"},{"$ref":"#/components/parameters/Page"},{"$ref":"#/components/parameters/ItemsPerPage"}],"responses":{"200":{"$ref":"#/components/responses/Visits"},"401":{"$ref":"#/components/responses/Unauthorized"}}}},
    "/domains/{domain}/visits": {"parameters":[{"name":"domain","in":"path","required":true,"schema":{"type":"string"}},{"$ref":"#/components/parameters/StartDate"},{"$ref":"#/components/parameters/EndDate"},{"$ref":"#/components/parameters/Page"}],"get":{"summary":"Get visits for a domain","security":[{"shlinkApiKey":[]}],"responses":{"200":{"$ref":"#/components/responses/Visits"}}}},
    "/tags/{tag}/visits": {"parameters":[{"name":"tag","in":"path","required":true,"schema":{"type":"string"}},{"$ref":"#/components/parameters/StartDate"},{"$ref":"#/components/parameters/EndDate"},{"$ref":"#/components/parameters/Page"}],"get":{"summary":"Get visits for a tag","security":[{"shlinkApiKey":[]}],"responses":{"200":{"$ref":"#/components/responses/Visits"}}}},
    "/api-keys": {
      "get":{"summary":"List API keys","security":[{"basicAuth":[]}],"responses":{"200":{"description":"API key metadata","content":{"application/json":{"schema":{"$ref":"#/components/schemas/ApiKeyList"}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}},
      "post":{"summary":"Create an API key","security":[{"basicAuth":[]}],"requestBody":{"required":true,"content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreateApiKey"}}}},"responses":{"201":{"description":"Created key; secret returned once","content":{"application/json":{"schema":{"$ref":"#/components/schemas/CreatedApiKey"}}}},"401":{"$ref":"#/components/responses/Unauthorized"}}}
    },
    "/api-keys/{name}": {"parameters":[{"name":"name","in":"path","required":true,"schema":{"type":"string"}}],"patch":{"summary":"Rename or disable an API key","security":[{"basicAuth":[]}],"requestBody":{"content":{"application/json":{"schema":{"$ref":"#/components/schemas/UpdateApiKey"}}}},"responses":{"200":{"description":"Updated"},"401":{"$ref":"#/components/responses/Unauthorized"}}},"delete":{"summary":"Delete an API key","security":[{"basicAuth":[]}],"responses":{"204":{"description":"Deleted"},"401":{"$ref":"#/components/responses/Unauthorized"}}}}
  },
  "components": {
    "securitySchemes":{"shlinkApiKey":{"type":"apiKey","in":"header","name":"X-Shlink-Api-Key","description":"Key created in Settings → API keys."},"basicAuth":{"type":"http","scheme":"basic","description":"Required only for API key administration."}},
    "parameters":{"ShortCode":{"name":"shortCode","in":"path","required":true,"schema":{"type":"string"}},"Page":{"name":"page","in":"query","schema":{"type":"integer","minimum":1,"default":1}},"ItemsPerPage":{"name":"itemsPerPage","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":10}},"SearchTerm":{"name":"searchTerm","in":"query","schema":{"type":"string"}},"TagsQuery":{"name":"tags","in":"query","schema":{"type":"string"},"description":"Comma-separated tag names."},"StartDate":{"name":"startDate","in":"query","schema":{"type":"string","format":"date"}},"EndDate":{"name":"endDate","in":"query","schema":{"type":"string","format":"date"}}},
    "responses":{"BadRequest":{"description":"Invalid request","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"Unauthorized":{"description":"Missing or invalid credentials","content":{"application/json":{"schema":{"$ref":"#/components/schemas/Error"}}}},"NotFound":{"description":"Resource not found"},"Visits":{"description":"Paginated visit records","content":{"application/json":{"schema":{"$ref":"#/components/schemas/PaginatedVisits"}}}}},
    "schemas":{
      "CreateShortUrl":{"type":"object","required":["longUrl"],"properties":{"longUrl":{"type":"string","format":"uri"},"customSlug":{"type":"string"},"findIfExists":{"type":"boolean"},"validateUrl":{"type":"boolean"},"tags":{"type":"array","items":{"type":"string"}},"domain":{"type":"string"},"validSince":{"type":"string","format":"date-time"},"validUntil":{"type":"string","format":"date-time"},"maxVisits":{"type":"integer","minimum":1}}},
      "UpdateShortUrl":{"type":"object","properties":{"longUrl":{"type":"string","format":"uri"},"customSlug":{"type":"string"},"tags":{"type":"array","items":{"type":"string"}},"domain":{"type":"string"},"validSince":{"type":"string","format":"date-time"},"validUntil":{"type":"string","format":"date-time"},"maxVisits":{"type":"integer","minimum":1}}},
      "ShortUrl":{"type":"object","properties":{"shortCode":{"type":"string"},"shortUrl":{"type":"string","format":"uri"},"longUrl":{"type":"string","format":"uri"},"dateCreated":{"type":"string","format":"date-time"},"tags":{"type":"array","items":{"type":"string"}}}},
      "PaginatedShortUrls":{"type":"object","properties":{"shortUrls":{"type":"array","items":{"$ref":"#/components/schemas/ShortUrl"}},"pagination":{"type":"object"}}},
      "PaginatedVisits":{"type":"object","properties":{"visits":{"type":"array","items":{"type":"object","properties":{"referer":{"type":"string","nullable":true},"date":{"type":"string","format":"date-time"},"userAgent":{"type":"string","nullable":true},"visitLocation":{"type":"object","nullable":true},"device":{"type":"object","nullable":true}}}},"pagination":{"type":"object"}}},
      "CreateApiKey":{"type":"object","required":["name"],"properties":{"name":{"type":"string","minLength":1},"expirationDate":{"type":"string","format":"date"},"authorOnly":{"type":"boolean"},"domainOnly":{"type":"string"},"noOrphanVisits":{"type":"boolean"}}},
      "CreatedApiKey":{"type":"object","required":["name","apiKey"],"properties":{"name":{"type":"string"},"apiKey":{"type":"string","description":"Secret returned only once."}}},
      "ApiKeyList":{"type":"object","properties":{"items":{"type":"array","items":{"$ref":"#/components/schemas/ApiKey"}}}},
      "ApiKey":{"type":"object","properties":{"name":{"type":"string"},"enabled":{"type":"boolean"},"expirationDate":{"type":"string","nullable":true},"roles":{"type":"array","items":{"type":"string"}}}},
      "UpdateApiKey":{"type":"object","properties":{"newName":{"type":"string"},"enabled":{"type":"boolean"}}},
      "Error":{"type":"object","properties":{"error":{"type":"string"}}}
    }
  }
}
