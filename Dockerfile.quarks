# Quarks Click admin console image.
# Build context must be the parent directory containing all three repos:
#   docker build -f shlink-web-client/Dockerfile.quarks -t quarks-admin:local .
# The three local checkouts (shlink-frontend-kit, shlink-web-component, shlink-web-client)
# are built in order, and the client consumes the two libraries through its file: dependencies
# (npm links them from the sibling directories), so the image always ships the forked code
# instead of the npm registry versions.

FROM node:26.7-alpine AS libs

# Build shlink-frontend-kit
COPY shlink-frontend-kit /siblings/shlink-frontend-kit
RUN cd /siblings/shlink-frontend-kit \
    && npm ci \
    && node --run build

# Build shlink-web-component against the local frontend-kit, linked from the sibling checkout
COPY shlink-web-component /siblings/shlink-web-component
RUN cd /siblings/shlink-web-component \
    && npm ci \
    && npm install --no-save --no-audit --no-fund ../shlink-frontend-kit \
    && node --run build

FROM node:26.7-alpine AS app
ARG VERSION="latest"
ENV VERSION=${VERSION}
COPY --from=libs /siblings /siblings
COPY shlink-web-client /shlink-web-client
# The client's file: dependencies point at ../shlink-frontend-kit and ../shlink-web-component.
# Symlink the built siblings into place so those paths resolve, then build against their dist
# output (LOCAL_LIBS=false disables the Vite source aliases used in local dev)
RUN ln -s /siblings/shlink-frontend-kit /shlink-frontend-kit \
    && ln -s /siblings/shlink-web-component /shlink-web-component \
    && cd /shlink-web-client \
    && npm install --no-audit --no-fund \
    && LOCAL_LIBS=false node --run build

FROM nginxinc/nginx-unprivileged:1.31.3-alpine
ARG UID=101

USER root
RUN rm -r /usr/share/nginx/html && rm /etc/nginx/conf.d/default.conf
COPY shlink-web-client/config/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY shlink-web-client/scripts/docker/servers_from_env.sh /docker-entrypoint.d/30-shlink-servers-json.sh
RUN sed -i 's/\r$//' /docker-entrypoint.d/30-shlink-servers-json.sh \
    && chmod 0755 /docker-entrypoint.d/30-shlink-servers-json.sh
COPY --from=app /shlink-web-client/build /usr/share/nginx/html

# This is required by 30-shlink-servers-json.sh to be writable for UID
RUN echo '[]' > /usr/share/nginx/html/servers.json \
    && chown $UID:0 /usr/share/nginx/html/servers.json

# Switch to non-privileged UID as the last step
USER $UID
